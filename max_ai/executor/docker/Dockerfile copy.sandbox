FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

ENV RUNTIME_DIR=/mnt
ENV TOOLS_DIR=/mnt/tools
ENV SKILLS_DIR=/mnt/skills
ENV ARTIFACTS_DIR=/mnt/artifacts
ENV WORKSPACE_DIR=/mnt/artifacts
ENV PYTHONPATH=/app

WORKDIR /mnt

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    bash ca-certificates curl findutils git jq procps ripgrep unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    jsonschema \
    pydantic \
    pydantic-settings \
    pyyaml \
    uv

RUN mkdir -p /app /mnt/tools /mnt/skills /mnt/artifacts

CMD ["/bin/bash"]
