{
    "name": "max_ai",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "workspaceFolder": "/max_ai",
    "workspaceMount": "source=${localWorkspaceFolder},target=/max_ai,type=bind,consistency=cached",
    "forwardPorts": [
        8081,
        3000,
        9001,
        "ollama:11434"
    ],
    "portsAttributes": {
        "8081": { "label": "Mongo Express" },
        "3000": { "label": "Langfuse" },
        "9001": { "label": "MinIO Console" },
        "ollama:11434": { "label": "Ollama API" }
    },
    "runArgs": [
        "--network=llm-vnet",
        "--gpus=all",
        "--cap-add=SYS_ADMIN",
        "--cap-add=SYS_CHROOT",
        "--cap-add=SETUID",
        "--cap-add=SETGID",
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined",
        "--security-opt=apparmor=unconfined"
    
    ],
    "hostRequirements": {
        "gpu": "optional"
    },
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
        "source=max_ai_volume,target=/root/.codex,type=volume,volume-subpath=max_ai_codex_config",
        "source=max_ai_volume,target=/root/.claude,type=volume,volume-subpath=max_ai_claude_config",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh-host,type=bind,consistency=cached,readonly"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.0": {
            "version": "latest",
            "moby": false
        }
    },
    "overrideCommand": true,
    "initializeCommand": "docker network create llm-vnet 2>/dev/null || true",
    "postCreateCommand": "bash /max_ai/.devcontainer/post-create.sh",

    "remoteEnv": {
        "OLLAMA_BASE_URL": "http://ollama:11434"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff",
                "njpwerner.autodocstring",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/max_ai/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "bash",
                        "icon": "terminal-bash"
                    }
                },
                "editor.inlineSuggest.enabled": true,
                "python.analysis.typeCheckingMode": "strict",
                "python.formatting.provider": "black",
                "python.linting.enabled": true,
                "python.linting.ruffEnabled": true,
                "python.linting.ruffArgs": [
                    "--fix"
                ]
            }
        }
    },
    "postStartCommand": "bash /max_ai/.devcontainer/post-start.sh"
}
