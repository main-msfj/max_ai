FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV SERVER_WORKSPACE=/sandbox

WORKDIR ${SERVER_WORKSPACE}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    findutils \
    git \
    jq \
    procps \
    ripgrep \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# TEMPORARY IN FUTURE: install package with uv/pip properly once it is library
COPY pyproject.toml ./
COPY max_ai ./max_ai

RUN touch README.md && uv pip install --system .

RUN mkdir -p "${SERVER_WORKSPACE}/tmp" "${SERVER_WORKSPACE}/var/skills-cache" "${SERVER_WORKSPACE}/tools"

CMD ["/bin/bash"]
