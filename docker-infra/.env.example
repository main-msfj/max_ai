# Local development defaults. Copy to .env in this directory to customize.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434
MONGODB_IMAGE=mongodb/mongodb-atlas-local:8.2
MONGODB_PORT=27017
MONGODB_USERNAME=maxai
MONGODB_PASSWORD=maxai-local-dev
MONGO_EXPRESS_IMAGE=mongo-express:1.0.2-20-alpine3.19
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=maxai
MONGO_EXPRESS_PASSWORD=maxai-local-ui
DUCKDUCKGO_IMAGE=mcp/duckduckgo:latest

# Langfuse (profile "observability"): UI at http://localhost:3000
LANGFUSE_PORT=3000
LANGFUSE_PUBLIC_KEY=pk-lf-maxai-local
LANGFUSE_SECRET_KEY=sk-lf-maxai-local
LANGFUSE_UI_EMAIL=admin@maxai.local
LANGFUSE_UI_PASSWORD=maxai-local-ui

# Object storage for remote workspaces (group "storage")
AZURITE_PORT=10000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=maxai
MINIO_ROOT_PASSWORD=maxai-local-dev
