FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV SERVER_WORKSPACE=/server_workspace
ENV SESSIONS_DIR=/server_workspace/tmp/session
ENV SKILLS_CACHE_DIR=/server_workspace/var/skills-cache

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        findutils \
        git \
        jq \
        procps \
        ripgrep \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

RUN mkdir -p \
    /server_workspace/tmp/session \
    /server_workspace/var/skills-cache \
    /workspace

WORKDIR /server_workspace

CMD ["/bin/bash"]
